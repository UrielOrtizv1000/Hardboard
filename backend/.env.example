# ==========================================================================
# Backend environment variables (template for the unimplemented scaffold)
# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# Names are provisional and will depend on the chosen provider and framework.
# All values are intentionally empty.
# ==========================================================================

# --- Server ---
PORT=
NODE_ENV=

# Frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=

# --- Payments (generic template; adapt to the chosen provider) ---
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_DEFAULT_CURRENCY=
DONATION_MIN_AMOUNT=
DONATION_MAX_AMOUNT=

# --- Redirect URLs after payment ---
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=

# --- Database ---
DATABASE_URL=
